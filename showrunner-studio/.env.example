# Server-only. Do not put these values in VITE_* variables.
TEXEL_API_KEY=
# Production encoder/voice editing credential; may differ from the generation key.
TEXEL_EDITING_API_KEY=
TEXEL_IMAGE_MODEL=juggernautXL_v8Rundiffusion.safetensors
# Optional: absolute directory on persistent storage. Defaults to backend/.texel-data.
# TEXEL_DATA_DIR=/absolute/path/to/studio-media

# Footage editing: S3-compatible bucket (AWS S3, Cloudflare R2, MinIO). The backend uploads user
# media here and gives Texel short-lived presigned URLs; the browser never sees them. The bucket
# must be reachable from Texel's servers over HTTPS. Add a lifecycle rule to expire texel-studio/*.
# TEXEL_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# TEXEL_S3_BUCKET=
# TEXEL_S3_ACCESS_KEY_ID=
# TEXEL_S3_SECRET_ACCESS_KEY=
# TEXEL_S3_REGION=auto

# Existing Script Lab / scene drafting credential, independent of Texel.
PROJEC_GOOGLE_API_KEY=
